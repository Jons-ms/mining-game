rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in player can access only their own private save.
    match /players/{playerId} {
      allow read, write: if request.auth != null && request.auth.uid == playerId;
    }

    // The existing browser game advances this shared rate using Firestore transactions.
    match /market/exchangeRate {
      allow read, write: if request.auth != null;
    }

    // Clients may see only the scheduler's deliberately limited public snapshot.
    match /podium/current {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
