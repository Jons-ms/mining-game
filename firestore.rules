rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Validates a shared exchange-rate document: exact fields, price inside the approved range,
    // sane trend values, and a lastPriceAt that matches the server clock. The time check stops a device
    // with a wrong clock from writing a far-future timestamp that would freeze the rate for everyone.
    function validRateData(minPrice, maxPrice) {
      let data = request.resource.data;
      return request.auth != null
        && data.keys().hasAll(['price', 'trendDirection', 'trendTicksLeft', 'lastPriceAt', 'updatedAt'])
        && data.keys().hasOnly(['price', 'trendDirection', 'trendTicksLeft', 'lastPriceAt', 'updatedAt'])
        && data.price is number
        && data.price >= minPrice
        && data.price <= maxPrice
        && data.trendDirection is int
        && data.trendDirection in [-1, 0, 1]
        && data.trendTicksLeft is int
        && data.trendTicksLeft >= 0
        && data.trendTicksLeft <= 10
        && data.lastPriceAt is int
        && data.lastPriceAt >= request.time.toMillis() - 60000
        && data.lastPriceAt <= request.time.toMillis() + 60000
        && data.updatedAt is timestamp;
    }

    // Each signed-in player can access only their own private save.
    match /players/{playerId} {
      allow read, write: if request.auth != null && request.auth.uid == playerId;
    }

    // CRYP shared rate: 0.25-7 UAH, starts at 1 UAH.
    match /market/exchangeRate {
      allow read: if request.auth != null;
      allow create: if validRateData(0.25, 7)
        && request.resource.data.price == 1
        && request.resource.data.trendDirection == 0
        && request.resource.data.trendTicksLeft == 0;
      allow update: if validRateData(0.25, 7);
    }

    // Blue has an independent shared rate document: 4.25-13.75 UAH, starts at 4.25 UAH.
    match /market/blueExchangeRate {
      allow read: if request.auth != null;
      allow create: if validRateData(4.25, 13.75)
        && request.resource.data.price == 4.25
        && request.resource.data.trendDirection == 0
        && request.resource.data.trendTicksLeft == 0;
      allow update: if validRateData(4.25, 13.75);
    }

    // Shared rate history for the Exchange chart. Docs "h-<cur>-<hour>" hold 5 s points (t0..t719) for one UTC hour,
    // docs "d-<cur>-<day>" hold 5 min points (t0..t287) for one UTC day. Every point is a write-once field "t<slot>".
    function historyInterval(docId) {
      return docId.matches('h-.*') ? 3600000 : 86400000;
    }
    function historyKeyOk(docId, key) {
      return docId.matches('h-.*')
        ? key.matches('t([0-9]|[1-9][0-9]|[1-6][0-9][0-9]|7[01][0-9])')
        : key.matches('t([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-7][0-9]|28[0-7])');
    }
    function historyPriceOk(cur, price) {
      return price is number
        && ((cur == 'cryp' && price >= 0.25 && price <= 7)
          || (cur == 'blue' && price >= 4.25 && price <= 13.75));
    }
    function historyPointKeys(data) {
      return data.keys().toSet().difference(['cur', 'start', 'expireAt'].toSet());
    }
    function validHistoryMeta(docId, data) {
      return data.keys().hasAll(['cur', 'start', 'expireAt'])
        && data.cur in ['cryp', 'blue']
        && data.start is int
        && data.start % historyInterval(docId) == 0
        && docId.matches('[hd]-.*')
        && docId == (docId.matches('h-.*') ? 'h-' : 'd-') + data.cur + '-' + string(math.floor(data.start / historyInterval(docId)))
        && data.start <= request.time.toMillis() + 60000
        && data.start >= request.time.toMillis() - 90000000
        && data.expireAt is timestamp;
    }
    match /marketHistory/{docId} {
      allow read: if request.auth != null;
      // A new doc carries its metadata and exactly one point.
      allow create: if request.auth != null
        && validHistoryMeta(docId, request.resource.data)
        && historyPointKeys(request.resource.data).size() == 1
        && historyKeyOk(docId, historyPointKeys(request.resource.data).toList()[0])
        && historyPriceOk(request.resource.data.cur, request.resource.data[historyPointKeys(request.resource.data).toList()[0]]);
      // An update adds exactly one new point and never rewrites existing ones or the metadata.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().size() == 1
        && !(request.resource.data.diff(resource.data).affectedKeys().toList()[0] in resource.data)
        && historyKeyOk(docId, request.resource.data.diff(resource.data).affectedKeys().toList()[0])
        && historyPriceOk(resource.data.cur, request.resource.data[request.resource.data.diff(resource.data).affectedKeys().toList()[0]]);
      allow delete: if false;
    }

    // CRYP BANK (beta). One account per player and currency: the document id is "<uid>_<currency>" and it can only
    // be created (never changed or deleted), together with a reservation "cardNumbers/<16 digits>" that keeps the
    // card number unique. The two documents must be written in one batch and must agree with each other.
    function validCardNumber(number, currency) {
      return number is string
        && ((currency == 'uah' && number.matches('9001[0-9]{12}'))
          || (currency == 'cryp' && number.matches('9002[0-9]{12}'))
          || (currency == 'blue' && number.matches('9003[0-9]{12}')));
    }
    match /bankAccounts/{accountId} {
      // Decided by the document id, not by resource.data: reading an account that is not opened yet must be allowed.
      allow read: if request.auth != null
        && accountId in [request.auth.uid + '_uah', request.auth.uid + '_cryp', request.auth.uid + '_blue'];
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'currency', 'cardNumber', 'openedAt'])
        && request.resource.data.keys().hasAll(['uid', 'currency', 'cardNumber', 'openedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.currency in ['uah', 'cryp', 'blue']
        && accountId == request.auth.uid + '_' + request.resource.data.currency
        && validCardNumber(request.resource.data.cardNumber, request.resource.data.currency)
        && request.resource.data.openedAt == request.time
        && getAfter(/databases/$(database)/documents/cardNumbers/$(request.resource.data.cardNumber)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/cardNumbers/$(request.resource.data.cardNumber)).data.currency == request.resource.data.currency;
      allow update, delete: if false;
    }
    match /cardNumbers/{cardNumber} {
      // Nobody can read the registry: a number cannot be looked up or traced to a player.
      allow read: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'currency', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'currency', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.currency in ['uah', 'cryp', 'blue']
        && validCardNumber(cardNumber, request.resource.data.currency)
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/bankAccounts/$(request.auth.uid + '_' + request.resource.data.currency)).data.cardNumber == cardNumber;
      allow update, delete: if false;
    }

    // Players publish only their own public ranking row; private saves remain private.
    match /podiumPlayers/{playerId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == playerId;
    }
  }
}
