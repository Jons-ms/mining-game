rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in player can access only their own private save.
    match /players/{playerId} {
      allow read, write: if request.auth != null && request.auth.uid == playerId;
    }

    // The existing browser game advances this shared rate using Firestore transactions.
    match /market/exchangeRate {
      allow read, write: if request.auth != null;
    }

    // Blue has an independent shared rate document; enforce its approved bounds in Firestore.
    match /market/blueExchangeRate {
      function validRateData() {
        return request.auth != null
          && request.resource.data.keys().hasAll(['price', 'trendDirection', 'trendTicksLeft', 'lastPriceAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['price', 'trendDirection', 'trendTicksLeft', 'lastPriceAt', 'updatedAt'])
          && request.resource.data.price is number
          && request.resource.data.price >= 4.25
          && request.resource.data.price <= 13.75
          && request.resource.data.trendDirection is int
          && (request.resource.data.trendDirection == -1 || request.resource.data.trendDirection == 0 || request.resource.data.trendDirection == 1)
          && request.resource.data.trendTicksLeft is int
          && request.resource.data.trendTicksLeft >= 0
          && request.resource.data.trendTicksLeft <= 10
          && request.resource.data.lastPriceAt is int
          && request.resource.data.updatedAt is timestamp;
      }

      allow read: if request.auth != null;
      allow create: if validRateData()
        && request.resource.data.price == 4.25
        && request.resource.data.trendDirection == 0
        && request.resource.data.trendTicksLeft == 0;
      allow update: if validRateData();
    }

    // Players publish only their own public ranking row; private saves remain private.
    match /podiumPlayers/{playerId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == playerId;
    }
  }
}

